:root{
  --bg:#0b1220;
  --panel:#111b33;
  --text:#e8eefc;
  --muted:#aeb9da;
  --brand:#4cc9f0;
  --accent:#3a86ff;
  --good:#2dd4bf;
  --warn:#fbbf24;
  --bad:#fb7185;
}

*{box-sizing:border-box}
body{
  margin:0;
  font-family:system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
  background:linear-gradient(180deg, #070c16, var(--bg));
  color:var(--text);
}

.topbar{
  position:sticky;
  top:0;
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:14px 22px;
  background:rgba(17,27,51,.85);
  backdrop-filter: blur(10px);
  border-bottom:1px solid rgba(255,255,255,.08);
}
.brand{
  display:flex; align-items:center; gap:10px;
}
.logo{font-size:24px}
.topbar nav a{
  margin-left:14px;
  color:var(--muted);
  text-decoration:none;
  font-weight:600;
}
.topbar nav a:hover{color:var(--text)}

.container{
  width:min(1100px, 92vw);
  margin: 18px auto 60px;
}

.hero{
  padding:18px;
  border:1px solid rgba(255,255,255,.08);
  background:rgba(17,27,51,.55);
  border-radius:14px;
}
.hero h2{margin:0 0 8px}

.grid{
  display:grid;
  grid-template-columns: repeat(4, 1fr);
  gap:12px;
  margin:18px 0;
}
@media (max-width: 900px){
  .grid{grid-template-columns: repeat(2,1fr)}
}
.card{
  background:rgba(17,27,51,.55);
  border:1px solid rgba(255,255,255,.08);
  border-radius:14px;
  padding:14px;
}
.card h3{margin:0 0 6px}

.cta{
  border:1px dashed rgba(76,201,240,.55);
  padding:18px;
  border-radius:14px;
  background:rgba(76,201,240,.06);
}
.btn{
  display:inline-block;
  margin-top:10px;
  padding:10px 14px;
  border-radius:12px;
  background:var(--accent);
  color:white;
  text-decoration:none;
  font-weight:800;
}

.footer{
  text-align:center;
  padding:22px;
  color:var(--muted);
  border-top:1px solid rgba(255,255,255,.08);
}
